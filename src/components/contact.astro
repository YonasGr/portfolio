---
import { Icon } from "astro-icon/components";
import Section from "./ui/section.astro";
import SectionHeader from "./ui/section-header.astro";
import Button from "./ui/button.astro";
import Badge from "./ui/badge.astro";
import EmptyState from "./ui/empty-state.astro";
import { focusRing } from "./ui/styles";
import { email, contactSocials, availability } from "../utils/profile";

const isAvailable = availability?.status === "available";
---

<Section id="contact">
  <SectionHeader
    id="contact"
    title="Get in touch"
    description="Whether you have an engineering project in mind, need technical leadership, or want to build high-performance software, my inbox is open."
  />

  <div class="grid gap-6 lg:grid-cols-3">
    <article class="flex min-w-0 flex-col gap-6 rounded-xl border border-zinc-200 bg-zinc-50/50 p-6 lg:col-span-2 dark:border-zinc-800 dark:bg-zinc-900/40">
      <div class="flex min-w-0 flex-col gap-2">
        <p class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Email</p>
        <p
          class="truncate font-heading text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50"
          title={email}
        >
          {email}
        </p>
        <p class="max-w-prose text-sm text-zinc-700 dark:text-zinc-300">
          Open for software engineering roles, full-stack architecture, and contract consulting.
          Typical response within 24 hours.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <div class="flex flex-wrap items-center gap-3">
          <Button id="copy-email-btn" variant="secondary" data-email={email}>
            <Icon name="mdi:content-copy" aria-hidden="true" />
            <span id="copy-email-label">Copy address</span>
          </Button>
          <Button variant="outline" href={`mailto:${email}`}>
            Open mail client
            <Icon name="mdi:arrow-top-right" aria-hidden="true" />
          </Button>
        </div>
        <p
          id="copy-status"
          role="status"
          aria-live="polite"
          class="min-h-4 text-xs text-zinc-500 data-[state=error]:text-red-500 data-[state=success]:text-emerald-600 dark:text-zinc-400 dark:data-[state=success]:text-emerald-400"
        >
        </p>
      </div>
    </article>

    <aside aria-label="Location and availability" class="min-w-0 rounded-xl border border-zinc-200 bg-zinc-50/50 p-6 dark:border-zinc-800 dark:bg-zinc-900/40">
      <dl class="flex flex-col divide-y divide-zinc-200 dark:divide-zinc-800">
        <div class="flex flex-col gap-1 pb-4">
          <dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Location</dt>
          <dd class="text-sm text-zinc-700 dark:text-zinc-300">Addis Ababa, Ethiopia · Remote worldwide</dd>
        </div>
        <div class="flex flex-col gap-1 py-4">
          <dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Timezone</dt>
          <dd class="text-sm tabular-nums text-zinc-700 dark:text-zinc-300">East Africa Time (UTC+3)</dd>
        </div>
        {availability && (
          <div class="flex flex-col gap-2 pt-4">
            <dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Availability</dt>
            <dd class="flex min-w-0 flex-col items-start gap-2">
              <Badge variant={isAvailable ? "success" : "neutral"} title={availability.badgeText}>
                {isAvailable ? "Available" : "Limited availability"}
              </Badge>
              {availability.openTo && availability.openTo.length > 0 && (
                <span class="text-sm text-zinc-700 dark:text-zinc-300">{availability.openTo.join(", ")}</span>
              )}
            </dd>
          </div>
        )}
      </dl>
    </aside>
  </div>

  <div class="mt-12 flex flex-col gap-4">
    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">Elsewhere</h3>

    {contactSocials.length > 0 ? (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {contactSocials.map((s) => (
          <li class="min-w-0">
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "flex min-w-0 items-center gap-3 rounded-xl border border-zinc-200 bg-zinc-50/50 p-4 transition-colors",
                "hover:border-zinc-300 active:bg-zinc-100",
                "dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:active:bg-zinc-900",
                focusRing,
              ]}
            >
              <Icon name={s.icon ?? "mdi:open-in-new"} class="size-5 shrink-0 text-zinc-500 dark:text-zinc-400" aria-hidden="true" />
              <span class="flex min-w-0 flex-1 flex-col gap-1">
                <span class="truncate text-sm font-semibold text-zinc-900 dark:text-zinc-50">{s.name}</span>
                <span class="truncate text-xs text-zinc-500 dark:text-zinc-400">{s.handle ?? s.url}</span>
              </span>
              <Icon name="mdi:arrow-top-right" class="size-4 shrink-0 text-zinc-400 dark:text-zinc-500" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState
        title="No public profiles listed"
        description="Social profiles haven't been added yet. Email is the best way to reach me."
        actionLabel="Send an email"
        actionHref={`mailto:${email}`}
      />
    )}
  </div>
</Section>

<script>
  const btn = document.getElementById("copy-email-btn") as HTMLButtonElement | null;
  const label = document.getElementById("copy-email-label");
  const status = document.getElementById("copy-status");
  let timer: number | undefined;

  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for non-secure contexts / older browsers.
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand("copy");
    document.body.removeChild(ta);
    if (!ok) throw new Error("Copy command was rejected");
  }

  function report(state: "success" | "error", message: string, buttonText: string) {
    if (status) {
      status.textContent = message;
      status.dataset.state = state;
    }
    if (label) label.textContent = buttonText;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (label) label.textContent = "Copy address";
      if (status) {
        status.textContent = "";
        delete status.dataset.state;
      }
    }, 3000);
  }

  btn?.addEventListener("click", async () => {
    try {
      await copyText(btn.dataset.email ?? "");
      report("success", "Email address copied to clipboard.", "Copied");
    } catch {
      report("error", "Couldn’t copy automatically. Select the address above and copy it manually.", "Copy address");
    }
  });
</script>
