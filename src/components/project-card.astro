---
import { Icon } from "astro-icon/components";
import Badge from "./ui/badge.astro";
import Button from "./ui/button.astro";
import Media from "./ui/media.astro";
import { parseMetric } from "../utils/metrics";
import type { ResolvedProject } from "../types";

interface Props {
  project: ResolvedProject;
  hidden?: boolean;
}

const { project, hidden = false } = Astro.props;
const metrics = (project.metrics ?? []).map(parseMetric);
---

<article
  id={`project-panel-${project.id}`}
  data-project-panel
  hidden={hidden}
  aria-label={project.title}
  class="overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-900/40"
>
  {project.primaryImage ? (
    <Media
      src={project.primaryImage}
      alt={`${project.title} preview`}
      class="aspect-video w-full border-b border-zinc-200 sm:aspect-[21/9] dark:border-zinc-800"
    />
  ) : (
    <div class="flex aspect-video w-full flex-col items-center justify-center gap-2 border-b border-zinc-200 bg-zinc-100 sm:aspect-[21/9] dark:border-zinc-800 dark:bg-zinc-900">
      <Icon name="mdi:image-outline" class="size-5 shrink-0 text-zinc-400 dark:text-zinc-500" aria-hidden="true" />
      <p class="text-xs text-zinc-400 dark:text-zinc-500">Preview coming soon</p>
    </div>
  )}

  <div class="flex flex-col gap-6 p-6">
    <header class="flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <Badge>{project.category}</Badge>
        <span class="text-xs tabular-nums text-zinc-400 dark:text-zinc-500">{project.year}</span>
        {project.platforms && project.platforms.length > 0 && (
          <span class="min-w-0 truncate text-xs text-zinc-400 dark:text-zinc-500">
            {project.platforms.join(" · ")}
          </span>
        )}
      </div>
      <h3 class="font-heading text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        {project.title}
      </h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">{project.tagline}</p>
    </header>

    <p class="max-w-prose text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
      {project.description}
    </p>

    {metrics.length > 0 && (
      <dl class="grid grid-cols-2 gap-4 border-y border-zinc-200 py-4 sm:grid-cols-4 dark:border-zinc-800">
        {metrics.map((m) => (
          <div class="flex min-w-0 flex-col-reverse gap-1">
            {m.label && <dt class="truncate text-xs text-zinc-500 dark:text-zinc-400" title={m.label}>{m.label}</dt>}
            <dd class="truncate text-xl font-semibold tabular-nums text-zinc-900 dark:text-zinc-50" title={m.value}>
              {m.value}
            </dd>
          </div>
        ))}
      </dl>
    )}

    {project.highlights && project.highlights.length > 0 && (
      <ul class="flex max-w-prose list-disc flex-col gap-2 pl-4 text-sm leading-relaxed text-zinc-700 marker:text-zinc-400 dark:text-zinc-300 dark:marker:text-zinc-600">
        {project.highlights.map((h) => <li>{h}</li>)}
      </ul>
    )}

    <footer class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <ul class="flex min-w-0 flex-wrap gap-2" aria-label="Technologies used">
        {project.tech.map((t) => (
          <li class="min-w-0 max-w-full"><Badge>{t}</Badge></li>
        ))}
      </ul>

      {(project.github || project.link) && (
        <div class="flex shrink-0 items-center gap-2">
          {project.github && (
            <Button variant="outline" size="sm" href={project.github}>
              <Icon name="mdi:github" aria-hidden="true" />
              Repository
            </Button>
          )}
          {project.link && (
            <Button variant="secondary" size="sm" href={project.link}>
              Live demo
              <Icon name="mdi:arrow-top-right" aria-hidden="true" />
            </Button>
          )}
        </div>
      )}
    </footer>
  </div>
</article>
