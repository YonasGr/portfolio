---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';

interface Props {
  project: {
    id: string;
    title: string;
    tagline: string;
    description: string;
    category: string;
    featured?: boolean;
    year: string;
    impact?: string;
    metrics?: string[] | { label: string; value: string }[];
    highlights?: string[];
    tech: string[];
    platforms?: string[];
    link?: string;
    github?: string;
    images: string[];
    primaryImage?: any;
  };
  index?: number;
  totalProjects?: number;
}

const { project } = Astro.props;

// Ensure primary image is available
let primaryImage = project.primaryImage;
if (!primaryImage && project.images && project.images.length > 0) {
  primaryImage = await resolveAssetImage(project.images[0]);
}
---

<article class="blueprint-card-pane flex flex-col w-full">
  <!-- Clean Image Viewport Screen -->
  <div class="viewport-screen relative w-full aspect-[16/9] sm:aspect-[21/9] overflow-hidden bg-[var(--bg-alt)] border-b border-[var(--border)]">
    {primaryImage ? (
      <Image
        src={primaryImage}
        alt={`${project.title} architectural overview`}
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-[var(--bg-alt)]">
        <Icon name="mdi:image-outline" class="w-12 h-12 text-[var(--accent)] opacity-40 mb-2" />
        <span class="font-mono text-xs text-[var(--text-3)]">PREVIEW COMING SOON</span>
      </div>
    )}

    <!-- Floating Top Badges -->
    <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between z-10 pointer-events-none">
      <div class="flex items-center gap-1.5">
        <span class="px-2.5 py-1 rounded-md font-mono text-[10px] tracking-wider uppercase" style="background: var(--surface); color: var(--accent); border: 1px solid var(--border-accent);">
          {project.category}
        </span>
        {project.platforms && project.platforms.length > 0 && (
          <span class="hidden sm:inline-flex px-2.5 py-1 rounded-md font-mono text-[10px]" style="background: var(--surface); color: var(--text-2); border: 1px solid var(--border);">
            {project.platforms.join(' · ')}
          </span>
        )}
      </div>
      <span class="px-2.5 py-1 rounded-md font-mono text-[10px]" style="background: var(--surface); color: var(--text-2); border: 1px solid var(--border);">
        {project.year}
      </span>
    </div>
  </div>

  <!-- Body Content -->
  <div class="p-5 sm:p-7 lg:p-8 flex flex-col gap-5 sm:gap-6">
    <!-- Title & Tagline -->
    <div>
      <h3 class="font-heading font-black text-xl sm:text-2xl lg:text-3xl tracking-tight leading-tight mb-1.5 text-[var(--text-1)]">
        {project.title}
      </h3>
      <p class="font-body text-xs sm:text-sm font-medium text-[var(--accent)] leading-relaxed">
        {project.tagline}
      </p>
    </div>

    <!-- Description -->
    <p class="font-body text-xs sm:text-sm leading-relaxed text-[var(--text-2)]">
      {project.description}
    </p>

    <!-- Performance Metrics Matrix -->
    {project.metrics && project.metrics.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
        {(project.metrics as any[]).map((m: any) => {
          const isObj = typeof m === 'object' && m !== null;
          const val = isObj ? m.value : m;
          const lbl = isObj ? m.label : 'VERIFIED METRIC';
          return (
            <div
              class="flex flex-col justify-center p-3 rounded-md transition-colors duration-200"
              style="background: var(--surface-2);"
            >
              <span class="font-heading font-black text-sm sm:text-base text-[var(--accent)] truncate">
                {val}
              </span>
              <span class="font-mono text-[9px] sm:text-[10px] uppercase tracking-wider text-[var(--text-2)] mt-0.5 truncate">
                {lbl}
              </span>
            </div>
          );
        })}
      </div>
    )}

    <!-- Architectural Highlights -->
    {project.highlights && project.highlights.length > 0 && (
      <div class="space-y-2 pt-2 border-t border-[var(--border)]">
        <span class="font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-[var(--text-3)] font-semibold">
          Key Highlights:
        </span>
        <div class="space-y-2">
          {project.highlights.map((h: string) => (
            <div class="flex items-start gap-2 text-xs sm:text-sm text-[var(--text-2)] leading-relaxed">
              <Icon name="mdi:chevron-right" class="w-4 h-4 shrink-0 text-[var(--accent)] mt-0.5" />
              <span>{h}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Tech Stack & Action Buttons -->
    <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--border)]">
      <!-- Tech tags -->
      <div class="flex flex-wrap gap-1.5">
        {project.tech.map((t: string) => (
          <span class="tag text-[10px] sm:text-[11px] py-1 px-2.5">
            {t}
          </span>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-xs py-2 px-3.5 flex items-center gap-1.5 rounded-full"
            style="border-radius: 9999px; font-size: 0.78rem;"
          >
            <Icon name="mdi:github" class="w-4 h-4" />
            <span>Repository</span>
          </a>
        )}
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs py-2 px-4 flex items-center gap-1.5 rounded-full"
            style="border-radius: 9999px; font-size: 0.78rem;"
          >
            <span>Live Demo</span>
            <Icon name="mdi:arrow-top-right" class="w-4 h-4" />
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .blueprint-card-pane {
    background: transparent;
  }
</style>