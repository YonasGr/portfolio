---
import { Icon } from "astro-icon/components";
import Button from "./ui/button.astro";
import Media from "./ui/media.astro";
import avatar from "../assets/profile-pic.jpg";
import {
  profileName,
  profileTitle,
  profileLocation,
  profileBio,
  resumeUrl,
  stats,
  heroSocials,
  availability,
} from "../utils/profile";
---

<section
  id="home"
  aria-labelledby="home-title"
  class="mx-auto w-full max-w-6xl px-4 pb-16 pt-28 sm:px-6 sm:pb-24 sm:pt-36 lg:px-8"
>
  <div class="grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:items-center lg:gap-16">
    <div class="order-2 flex min-w-0 flex-col gap-6 lg:order-1">
      <header class="flex flex-col gap-2">
        {availability && (
          <p class="mb-2 inline-flex w-fit items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">
            <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {availability.badgeText ?? "Available for new work"}
          </p>
        )}
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">Independent engineer · Addis Ababa</p>
        <h1 id="home-title" class="max-w-2xl font-heading text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
          I build dependable products for people and teams who care about the details.
        </h1>
        <p class="text-sm text-zinc-700 dark:text-zinc-300">{profileName} · {profileTitle}</p>
        {profileLocation && (
          <p class="flex items-center gap-1 text-xs text-zinc-400 dark:text-zinc-500">
            <Icon name="mdi:map-marker-outline" class="size-4 shrink-0" aria-hidden="true" />
            <span class="truncate">{profileLocation}</span>
          </p>
        )}
      </header>

      <p class="max-w-prose text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
        {profileBio}
      </p>

      <!-- The only solid primary action on the page. -->
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="primary" href="#projects">
          View work
          <Icon name="mdi:arrow-right" aria-hidden="true" />
        </Button>
        <Button variant="outline" href={resumeUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="mdi:file-document-outline" aria-hidden="true" />
          Resume
        </Button>
      </div>
    </div>

    <div class="hero-showcase order-1 min-h-72 overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900/40 sm:min-h-80 lg:order-2">
      <div class="flex h-full min-h-64 flex-col justify-between rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-start justify-between gap-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-500">Systems / interfaces / impact</span>
          <Media
            src={avatar}
            alt={profileName}
            width={160}
            height={160}
            quality={88}
            loading="eager"
            class="size-16 rounded-lg border border-zinc-200 dark:border-zinc-800"
          />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-md border border-zinc-200 bg-zinc-50 p-3 dark:border-zinc-800 dark:bg-zinc-900/60">
            <span class="mb-5 block text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Focus</span>
            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-50">Useful complexity</span>
          </div>
          <div class="rounded-md border border-zinc-200 bg-zinc-50 p-3 dark:border-zinc-800 dark:bg-zinc-900/60">
            <span class="mb-5 block text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Mode</span>
            <span class="text-sm font-medium text-zinc-900 dark:text-zinc-50">Remote · UTC+3</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {stats.length > 0 && (
    <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-zinc-200 pt-6 sm:grid-cols-4 dark:border-zinc-800">
      {stats.map((s) => (
        <div class="flex min-w-0 flex-col-reverse gap-1">
          <dt class="line-clamp-2 text-xs font-medium text-zinc-500 dark:text-zinc-400">{s.label}</dt>
          <dd class="font-heading text-xl font-semibold tracking-tight tabular-nums text-zinc-900 dark:text-zinc-50">
            {s.value}
          </dd>
        </div>
      ))}
    </dl>
  )}

  {heroSocials.length > 0 && (
    <nav aria-label="Social links" class="mt-8 flex flex-wrap gap-2">
      {heroSocials.map((s) => (
        <Button variant="ghost" size="sm" href={s.url} aria-label={s.name} title={s.name}>
          <Icon name={s.icon ?? "mdi:open-in-new"} aria-hidden="true" />
          <span class="hidden sm:inline">{s.name}</span>
        </Button>
      ))}
    </nav>
  )}
</section>
