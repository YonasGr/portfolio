---
import projectsData from "../data/projects.json";
import ProjectCard from "./project-card.astro";
import Section from "./ui/section.astro";
import SectionHeader from "./ui/section-header.astro";
import EmptyState from "./ui/empty-state.astro";
import { focusRing } from "./ui/styles";
import { resolveAssetImage } from "../utils/images";
import { email } from "../utils/profile";
import type { Project, ResolvedProject } from "../types";

const projects: ResolvedProject[] = await Promise.all(
  (projectsData as Project[]).map(async (p) => {
    const images = await Promise.all((p.images ?? []).map((img) => resolveAssetImage(img)));
    return { ...p, primaryImage: images.find(Boolean) ?? null };
  }),
);

const shortName = (title: string) => title.split("—")[0].trim();
---

<Section id="projects">
  <SectionHeader
    id="projects"
    title="Selected projects"
    description={projects.length > 0
      ? `${projects.length} case ${projects.length === 1 ? "study" : "studies"} with stack, impact and links.`
      : undefined}
  />

  {projects.length > 0 ? (
    <div class="grid gap-6 lg:grid-cols-[20rem_1fr] lg:items-start xl:grid-cols-[22rem_1fr]">
      <ul
        aria-label="Projects"
        class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0 lg:pb-0"
      >
        {projects.map((p, idx) => (
          <li class="w-64 shrink-0 lg:w-auto">
            <button
              type="button"
              data-project-tab
              aria-pressed={idx === 0 ? "true" : "false"}
              aria-controls={`project-panel-${p.id}`}
              class:list={[
                "flex w-full min-w-0 cursor-pointer flex-col gap-1 rounded-xl border p-4 text-left transition-colors",
                "border-zinc-200 bg-zinc-50/50 hover:border-zinc-300 active:bg-zinc-100",
                "dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-zinc-700 dark:active:bg-zinc-900",
                "aria-pressed:border-accent aria-pressed:bg-zinc-100 dark:aria-pressed:border-accent dark:aria-pressed:bg-zinc-900",
                "disabled:pointer-events-none disabled:opacity-50",
                focusRing,
              ]}
            >
              <span class="flex min-w-0 items-center justify-between gap-2">
                <span class="truncate text-sm font-semibold text-zinc-900 dark:text-zinc-50">
                  {shortName(p.title)}
                </span>
                <span class="shrink-0 text-xs tabular-nums text-zinc-400 dark:text-zinc-500">{p.year}</span>
              </span>
              <span class="hidden text-xs text-zinc-500 lg:line-clamp-2 dark:text-zinc-400">{p.tagline}</span>
              <span class="truncate text-xs text-zinc-400 dark:text-zinc-500">{p.category}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="min-w-0 lg:sticky lg:top-24">
        {projects.map((p, idx) => (
          <ProjectCard project={p} hidden={idx !== 0} />
        ))}
      </div>
    </div>
  ) : (
    <EmptyState
      title="No projects published yet"
      description="Case studies are on their way. In the meantime, I'm happy to walk through relevant work."
      actionLabel="Ask about my work"
      actionHref={`mailto:${email}`}
    />
  )}
</Section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-project-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-project-panel]");

  const select = (index: number) => {
    tabs.forEach((tab, i) => tab.setAttribute("aria-pressed", String(i === index)));
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });
    // Keeps the active tab in view inside the horizontal scroller on small screens.
    tabs[index]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
  };

  tabs.forEach((tab, i) => tab.addEventListener("click", () => select(i)));
</script>
