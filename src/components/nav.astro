---
import ThemeToggle from './theme-toggle.astro';

const navItems = [
  { label: "Work",      href: "#projects" },
  { label: "Career",    href: "#career"   },
  { label: "Tech",      href: "#tech"     },
  { label: "Contact",   href: "#contact"  },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 w-full"
  style="border-bottom: 1px solid transparent; transition: border-color 0.3s, background 0.3s;"
>
  <div class="w-full px-5 sm:px-8 md:px-14 lg:px-20 max-w-[1440px] mx-auto h-14 sm:h-16 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a
      href="#home"
      class="nav-logo flex items-center gap-2.5 shrink-0 group focus:outline-none"
      aria-label="Yonas Girma – Home"
    >
      <div
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-md flex items-center justify-center font-heading font-black text-xs sm:text-sm transition-colors duration-200"
        style="background: var(--accent); color: var(--on-accent);"
      >
        YG
      </div>
      <span class="font-heading font-bold text-sm hidden sm:inline tracking-tight transition-colors duration-200" style="color: var(--text-1);">
        Yonas Girma
      </span>
    </a>

    <!-- Center nav links -->
    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-0.5">
      {navItems.map(item => (
        <a
          href={item.href}
          class="nav-link px-3.5 py-2 rounded-md font-body text-sm font-medium transition-colors duration-150"
          style="color: var(--text-2);"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right: theme + hire CTA + mobile menu dots -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <ThemeToggle />

      <a
        href="mailto:yonasgirma222@gmail.com"
        class="btn-primary hidden sm:inline-flex text-xs px-4 py-2"
        style="padding: 0.45rem 1.1rem; font-size: 0.8125rem;"
      >
        Hire Me
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
          <path d="M16.004 9.41421L7.39768 18.0208L5.98347 16.6066L14.5898 8H7.00404V6H18.004V17H16.004V9.41421Z"/>
        </svg>
      </a>

      <!-- Mobile hamburger (icon only) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-md transition-colors duration-150"
        style="border: 1px solid var(--border); color: var(--text-2);"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M3 4h18v2H3V4zm0 7h18v2H3v-2zm0 7h18v2H3v-2z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown -->
  <div
    id="mobile-menu"
    class="md:hidden hidden"
    style="border-top: 1px solid var(--border); background: var(--bg);"
  >
    <div class="px-5 py-4 flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class="mobile-nav-link px-3 py-3 rounded-md font-body text-sm font-medium transition-colors duration-150"
          style="color: var(--text-2);"
        >
          {item.label}
        </a>
      ))}
      <a
        href="mailto:yonasgirma222@gmail.com"
        class="mt-2 btn-primary text-sm justify-center"
      >
        Hire Me ↗
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link:hover,
  .mobile-nav-link:hover {
    color: var(--text-1) !important;
    background: var(--surface);
  }

  .nav-link.active {
    color: var(--accent) !important;
    background: var(--accent-dim-2);
  }

  #site-header.scrolled {
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-color: var(--border) !important;
  }
</style>

<script>
  function setup() {
    const header = document.getElementById('site-header');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    const sections = document.querySelectorAll<HTMLElement>('section[id]');

    // Scroll styling
    const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 20);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Mobile toggle
    mobileBtn?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('hidden') === false;
      mobileBtn.setAttribute('aria-expanded', String(isOpen));
      mobileBtn.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    });

    // Close mobile on link click
    document.querySelectorAll('.mobile-nav-link, .nav-link').forEach(link => {
      link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
    });

    // Smooth scroll
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const id = a.getAttribute('href')?.slice(1);
        const el = id && document.getElementById(id);
        if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth' }); }
      });
    });

    // Active section tracking
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${id}`));
        }
      });
    }, { rootMargin: '-25% 0px -65% 0px' });
    sections.forEach(s => io.observe(s));
  }

  setup();
  document.addEventListener('astro:after-swap', setup);
</script>
