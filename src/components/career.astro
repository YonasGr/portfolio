---
import careerData from "../data/career.json";
import CareerCard from "./career-card.astro";
import Section from "./ui/section.astro";
import SectionHeader from "./ui/section-header.astro";
import EmptyState from "./ui/empty-state.astro";
import { email } from "../utils/profile";
import type { CareerItem } from "../types";

const items = careerData as CareerItem[];
---

<Section id="career">
  <SectionHeader
    id="career"
    title="Experience"
    description="Roles, responsibilities and outcomes, most recent first."
  />

  {items.length > 0 ? (
    <ol class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {items.map((item) => <CareerCard item={item} />)}
    </ol>
  ) : (
    <EmptyState
      title="No experience listed yet"
      description="Work history hasn't been added to this portfolio. Reach out for a CV."
      actionLabel="Request a CV"
      actionHref={`mailto:${email}`}
    />
  )}
</Section>
