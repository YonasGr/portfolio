---
import { Icon } from "astro-icon/components";
import IconButton from "./ui/icon-button.astro";
---

<IconButton id="theme-toggle" label="Toggle light and dark theme" variant="outline">
  <!-- Sun is shown in dark mode (click for light); moon in light mode. -->
  <Icon name="mdi:white-balance-sunny" class="hidden dark:block" aria-hidden="true" />
  <Icon name="mdi:moon-waning-crescent" class="block dark:hidden" aria-hidden="true" />
</IconButton>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const current = root.getAttribute("data-theme") ?? "default-dark";
    const next = current.endsWith("-dark")
      ? current.replace("-dark", "-light")
      : current.replace("-light", "-dark");
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage can be unavailable (private mode); the toggle still works for this visit.
    }
  });
</script>
