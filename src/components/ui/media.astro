---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  quality?: number;
  loading?: "eager" | "lazy";
}

const { src, alt, class: className, width, height, quality, loading = "lazy" } = Astro.props;
---

{/* Layout-matched skeleton: sits under the image and is removed once it loads. */}
<div class:list={["relative overflow-hidden bg-zinc-100 dark:bg-zinc-900", className]}>
  <div
    data-skeleton
    aria-hidden="true"
    class="absolute inset-0 animate-pulse bg-zinc-200 dark:bg-zinc-800"
  >
  </div>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    quality={quality}
    loading={loading}
    class="relative size-full object-cover object-center"
    onload="this.parentElement.querySelector('[data-skeleton]')?.remove()"
    onerror="this.parentElement.querySelector('[data-skeleton]')?.remove()"
  />
</div>
