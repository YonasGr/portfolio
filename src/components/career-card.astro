---
import { Icon } from "astro-icon/components";
import Badge from "./ui/badge.astro";
import type { CareerItem } from "../types";

interface Props {
  item: CareerItem;
}

const { item } = Astro.props;
const isCurrent = /present/i.test(item.period);
---

<li class="grid gap-4 py-8 first:pt-0 last:pb-0 md:grid-cols-[10rem_1fr] md:gap-8">
  <div class="flex min-w-0 flex-col gap-1">
    <p class="text-xs font-medium tabular-nums text-zinc-500 dark:text-zinc-400">{item.period}</p>
    {item.location && (
      <p class="flex min-w-0 items-start gap-1 text-xs text-zinc-400 dark:text-zinc-500">
        <Icon name="mdi:map-marker-outline" class="size-4 shrink-0" aria-hidden="true" />
        <span class="line-clamp-2" title={item.location}>{item.location}</span>
      </p>
    )}
  </div>

  <article class="flex min-w-0 flex-col gap-4">
    <header class="flex flex-col gap-1">
      {(item.type || isCurrent) && (
        <div class="mb-1 flex flex-wrap items-center gap-2">
          {item.type && <Badge>{item.type}</Badge>}
          {isCurrent && <Badge variant="success">Current</Badge>}
        </div>
      )}
      <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">{item.role}</h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">{item.company}</p>
    </header>

    <p class="max-w-prose text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
      {item.description}
    </p>

    {item.achievements && item.achievements.length > 0 && (
      <ul class="flex max-w-prose list-disc flex-col gap-2 pl-4 text-sm leading-relaxed text-zinc-700 marker:text-zinc-400 dark:text-zinc-300 dark:marker:text-zinc-600">
        {item.achievements.map((achievement) => <li>{achievement}</li>)}
      </ul>
    )}

    {item.skills && item.skills.length > 0 && (
      <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
        {item.skills.map((skill) => (
          <li class="min-w-0 max-w-full">
            <Badge>{skill}</Badge>
          </li>
        ))}
      </ul>
    )}
  </article>
</li>
