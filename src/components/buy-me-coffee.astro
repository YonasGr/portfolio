---
import { Icon } from "astro-icon/components";
import Button from "./ui/button.astro";

interface Props {
  username?: string;
}

const { username = "yonasgr" } = Astro.props;
const bmcUrl = `https://www.buymeacoffee.com/${username}`;
---

<aside aria-label="Support">
  <Button
    variant="floating"
    href={bmcUrl}
    aria-label="Buy me a coffee"
    class="fixed bottom-6 left-6 z-40 max-sm:w-10 max-sm:px-0"
  >
    <Icon name="mdi:coffee-outline" aria-hidden="true" />
    <span class="hidden sm:inline">Buy me a coffee</span>
  </Button>
</aside>
