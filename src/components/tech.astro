---
import { Icon } from "astro-icon/components";
import localTechData from "../data/tech.json";
import Section from "./ui/section.astro";
import SectionHeader from "./ui/section-header.astro";
import EmptyState from "./ui/empty-state.astro";
import { email } from "../utils/profile";
import type { TechCategory } from "../types";

const categories = (localTechData.categories as TechCategory[]).filter((c) => c.skills.length > 0);
const totalSkills = categories.reduce((sum, c) => sum + c.skills.length, 0);
---

<Section id="tech">
  <SectionHeader
    id="tech"
    title="Tech stack"
    description={totalSkills > 0
      ? `${totalSkills} technologies across ${categories.length} areas.`
      : undefined}
  />

  {categories.length > 0 ? (
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {categories.map((cat) => (
        <section
          aria-labelledby={`tech-${cat.id}`}
          class="grid gap-4 py-8 first:pt-0 last:pb-0 lg:grid-cols-[16rem_1fr] lg:gap-8"
        >
          <header class="flex min-w-0 flex-col gap-1">
            <h3 id={`tech-${cat.id}`} class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">
              {cat.title}
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">{cat.description}</p>
          </header>

          <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {cat.skills.map((skill) => (
              <li class="flex min-w-0 items-center gap-3" title={skill.description || skill.name}>
                <Icon name={skill.icon} class="size-5 shrink-0" aria-hidden="true" />
                <span class="min-w-0 flex-1 truncate text-sm text-zinc-900 dark:text-zinc-50">{skill.name}</span>
                <span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-500">{skill.tier}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <EmptyState
      title="No technologies listed yet"
      description="The stack hasn't been filled in. Ask me what I'd use for your project."
      actionLabel="Get in touch"
      actionHref={`mailto:${email}`}
    />
  )}
</Section>
