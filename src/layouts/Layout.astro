---
import '../styles/global.css';
import { SITE_CONFIG } from '../config.ts';
import favicon from '../assets/Y-Logo.png';
import SpeedInsights from "@vercel/speed-insights/astro";
import BuyMeCoffee from '../components/buy-me-coffee.astro';

interface Props { title: string; }
const { title } = Astro.props;
const baseTheme = SITE_CONFIG.baseTheme;
const defaultTheme = `${baseTheme}-dark`;
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>

    <!-- Prevent theme flash -->
    <script is:inline define:vars={{ defaultTheme }}>
      (function() {
        const valid = ['default-dark','default-light'];
        try {
          const saved = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', (saved && valid.includes(saved)) ? saved : defaultTheme);
        } catch(e) {
          document.documentElement.setAttribute('data-theme', defaultTheme);
        }
      })();
    </script>
  </head>

  <body class="relative min-h-screen w-full overflow-x-hidden antialiased">
    <a href="#home" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-[var(--accent)] focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-[var(--on-accent)]">
      Skip to content
    </a>

    <slot />

    <!-- Floating Buy Me a Coffee button -->
    <BuyMeCoffee username="yonasgr" />

    <!-- Back-to-top button -->
    <button
      id="to-top"
      class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-lg flex items-center justify-center transition-all duration-300 translate-y-14 opacity-0 pointer-events-none cursor-pointer"
      style="background: var(--surface-2); border: 1px solid var(--border);"
      aria-label="Back to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" style="color: var(--accent);">
        <path d="M13 7.828V20h-2V7.828l-5.364 5.364-1.414-1.414L12 4l7.778 7.778-1.414 1.414L13 7.828z"/>
      </svg>
    </button>

    <script>
      const btn = document.getElementById('to-top');
      window.addEventListener('scroll', () => {
        if (!btn) return;
        const show = window.scrollY > 400;
        btn.classList.toggle('translate-y-14', !show);
        btn.classList.toggle('opacity-0', !show);
        btn.classList.toggle('pointer-events-none', !show);
        btn.classList.toggle('translate-y-0', show);
        btn.classList.toggle('opacity-100', show);
      }, { passive: true });
      btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>

    <!-- Scroll reveal -->
    <script>
      function setupReveal() {
        document.querySelectorAll('.reveal').forEach(el => {
          new IntersectionObserver(([entry], obs) => {
            if (entry.isIntersecting) {
              el.classList.add('visible');
              obs.disconnect();
            }
          }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 }).observe(el);
        });
      }
      setupReveal();
      document.addEventListener('astro:after-swap', setupReveal);
    </script>

    <SpeedInsights />
  </body>
</html>