# All variables are optional. The site builds and runs without them.

# Canonical URL used for metadata, sitemap and social cards.
# On Vercel this is detected automatically; set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Raises the GitHub API limit from 60 to 5000 requests/hour so the
# "On GitHub" section keeps working from shared build IPs. A token with
# no scopes (public data only) is enough.
GITHUB_TOKEN=

# Enables the contact form (sends mail through Resend). Without both of
# these the form is hidden and visitors see your email and socials instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use onboarding@resend.dev until you verify a domain in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
